     dbDeleteObject(grad2 tail2 mid3 tmp)
    ;;Make a basic mid3 without 45X & outer contents

     tail2diag=dbCreatePathSeg(cv "M3"
        75.0-(Pw+Ps)*0.5:-50*Ra+Pw*0.5+(Pw+Ps)*5
        75.0+(Pw+Ps)*0.5:-50*Ra+Pw*0.5+(Pw+Ps)*6
        diagPathWidth "custom" "custom"
        list(diagPathWidth*0.5 diagPathWidth*0.5
        list(1.25 1.25 diagPathWidth*0.5 1.25 1.25 diagPathWidth*0.5)))
        tail2last=dbCreatePath(cv "M3"
        list(74.5+(Pw+Ps)*0.5:-50*Ra+Pw*0.5+(Pw+Ps)*6
        88.0:-50*Ra+Pw*0.5+(Pw+Ps)*6)
        2.5)
      mid3=car(dbLayerOr(cv "M3" 
      list(tail2diag tail2last mid3basic)))
       ;Create Main Path2 
     dbDeleteObject(tail2diag tail2last)

       tail2diag=dbCreatePathSeg(cv "M3"
        75.0-(Pw+Ps)*0.5:-50*Ra+Pw*0.5+(Pw+Ps)*5
        75.0+(Pw+Ps)*0.5:-50*Ra+Pw*0.5+(Pw+Ps)*4
        diagPathWidth "custom" "custom"
        list(diagPathWidth*0.5 diagPathWidth*0.5
        list(1.25 1.25 diagPathWidth*0.5 1.25 1.25 diagPathWidth*0.5)))
        tail2last=dbCreatePath(cv "M3"
        list(74.5+(Pw+Ps)*0.5:-50*Ra+Pw*0.5+(Pw+Ps)*4
        88.0:-50*Ra+Pw*0.5+(Pw+Ps)*4)
        2.5)
    tmp=car(dbLayerOr(cv "M3" list(tail2diag tail2last mid3basic)))
    mid3m=dbCopyFig(tmp cv list(150:0 "R180"))
    dbDeleteObject(tail2diag tail2last tmp mid3basic)
     
     
     m3mpts=mid3m~>points
    ;;Create Main PathMirror2 
     m3pts=mid3~>points
   
     l1=list(out0pts)
     l2=list(m3mpts)
     ov=car(dbPointArrayAnd(cv l1 l2))
     dbCreateViaShapeArray(cv "VIA4" techGetTechFile(cv)
     xCoord(car(ov))+0.75
     yCoord(car(ov))+0.5 3.0 3.0 1.5 1.5 1 3)

     
      l1=list(m3pts)
      l2=list(out0mpts)
      ov=car(dbPointArrayAnd(cv l1 l2))
      dbCreateViaShapeArray(cv "VIA4" techGetTechFile(cv) xCoord(car(ov))+0.75
       yCoord(car(ov))+0.5 3.0 3.0 1.5 1.5 1 3)

