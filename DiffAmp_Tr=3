            in6 in6pts in6m in6mpts in6bot in6top
            sp1 mid4p1 mid4p2 mid4p3 mid4p4 mid4 mid4x mid4top mid4bot sp2
            mid3 mid3x mid3BK mid3m m3mpts mid3p1 mid3p2 mid3p3 mid3p4 mid3top
            mid3bot grad2 tail2 tail2diag tail2last l1 l2 m3pts ov)
            cv=pcCellView
            tfId=techGetTechFile(ddGetObj("tsmcN28"))
            ;tfId=techGetTechFile(cv)
            snapGrid=techGetMfgGridResolution(tfId)
        
        temp=(Pw-2.5)*0.5
        diagPathWidth=ceiling(2.5*sqrt(2)/(snapGrid*2)*(snapGrid*2))
        case(Tr
   ((3)
         
              out0p1=68.0:50*Ra-Pw*0.5-(Pw+Ps)*4
              out0p2=25.0+Pw*0.5+(Pw+Ps)*4:50*Ra-Pw*0.5-(Pw+Ps)*4
              out0p3=25.0+Pw*0.5+(Pw+Ps)*4:-50*Ra+Pw*0.5+(Pw+Ps)*4
              out0p4=75.0-(Pw+Ps)*0.5:-50*Ra+Pw*0.5+(Pw+Ps)*4
              out0=dbCreatePath(cv "M4"
                list(out0p1 out0p2
                   out0p3 out0p4)
                    Pw)

                p1=68.0+temp:50*Ra-temp-(Pw+Ps)*4
                p2=68.0+temp:50*Ra-temp-2.5-(Pw+Ps)*4
                out0top=68.0:50*Ra-(Pw+Ps)*4
                out0bot=68.0:50*Ra-Pw-(Pw+Ps)*4
                grad1=dbCreatePolygon(cv "M4" 
                list(out0top p1 p2 out0bot))
                tail1=dbCreatePath(cv "M4"
                    list(68.0+temp:50*Ra-Pw*0.5-(Pw+Ps)*4
                    75.0-(Pw+Ps)*0.5:50*Ra-Pw*0.5-(Pw+Ps)*4)
                    2.5)
                tmp=car(dbLayerOr(cv "M4"
                list(tail1 grad1 out0)))
                dbDeleteObject(tail1 grad1 out0)
                out0=tmp
                out0pts=out0~>points

                ;Create out0
                tail1diag=dbCreatePathSeg(cv "M4"
                    75.0-(Pw+Ps)*0.5:50*Ra-Pw*0.5-(Pw+Ps)*4
                    75.0+(Pw+Ps)*0.5:50*Ra-Pw*0.5-(Pw+Ps)*5
                    diagPathWidth "custom" "custom"
                    list(diagPathWidth*0.5 diagPathWidth*0.5
                    list(1.25 1.25 diagPathWidth*0.5 1.25 1.25 diagPathWidth*0.5)))
                tail1last=dbCreatePath(cv "M4"
                    list(75.0+(Pw+Ps)*0.5:50*Ra-Pw*0.5-(Pw+Ps)*5
                    88.0:50*Ra-Pw*0.5-(Pw+Ps)*5)
                    2.5)
                     tmp=car(dbLayerOr(cv "M4"
                    list(tail1 tail1diag tail1last out0)))
                out0m=dbCopyFig(tmp cv list(150:0 "MY"))
                dbDeleteObject(tail1diag tail1last tmp)
                out0mpts=out0m~>points
                ;;Create out0m

                in6p1=75.0-(Pw+Ps)*0.5:50*Ra-(Pw+Ps)*6-Pw*0.5
                in6p2=25+(Pw+Ps)*6+Pw*0.5:50*Ra-(Pw+Ps)*6-Pw*0.5
                in6p3=25+(Pw+Ps)*6+Pw*0.5:-50*Ra+(Pw+Ps)*6+Pw*0.5
                in6p4=68.0:-50*Ra+(Pw+Ps)*6+Pw*0.5
                in6=dbCreatePath(cv "M4" 
                list(in6p1 in6p2 
                in6p3 in6p4) Pw)
               
                in6bot=68.0:-50*Ra+(Pw+Ps)*6
                in6top=68.0:-50*Ra+(Pw+Ps)*6+Pw
                p1=68.0+temp:-50*Ra+(Pw+Ps)*6+temp
                p2=68.0+temp:-50*Ra+(Pw+Ps)*6+temp+2.5
                grad1=dbCreatePolygon(cv "M4"
                list(in6bot p1 p2 in6top))
                tail1=dbCreatePath(cv "M4"
                    list(68.0+temp:-50*Ra+(Pw+Ps)*6+Pw*0.5
                    75.0-(Pw+Ps)*0.5:-50*Ra+(Pw+Ps)*6+Pw*0.5)
                    2.5)
                in6x=car(dbLayerOr(cv "M4" 
                list(tail1 grad1 in6)))
                dbDeleteObject(tail1 grad1 in6)
                in6=in6x
                in6m=dbCopyFig(in6 cv list(150:0 "MY"))
                in6mpts=in6m~>points
                ;Create in6m

                tail1=dbCreatePath(cv "M4"
                    list(68.0+temp:-50*Ra+(Pw+Ps)*6+Pw*0.5
                    75.0-(Pw+Ps)*0.5:-50*Ra+(Pw+Ps)*6+Pw*0.5)
                    2.5)
                tail1diag=dbCreatePathSeg(cv "M4"
                    75.0-(Pw+Ps)*0.5:-50*Ra+(Pw+Ps)*6+Pw*0.5
                    75.0+(Pw+Ps)*0.5:-50*Ra+(Pw+Ps)*5+Pw*0.5
                    diagPathWidth "custom" "custom"
                    list(diagPathWidth*0.5 diagPathWidth*0.5
                    list(1.25 1.25 diagPathWidth*0.5 1.25 1.25 diagPathWidth*0.5)))
                tail1last=dbCreatePath(cv "M4"
                    list(75.0+(Pw+Ps)*0.5:-50*Ra+(Pw+Ps)*5+Pw*0.5
                    88.0:-50*Ra+(Pw+Ps)*5+Pw*0.5)
                    2.5)
                in6x=car(dbLayerOr(cv "M4"
                    list(tail1 tail1diag grad1 
                tail1 tail1last in6)))
