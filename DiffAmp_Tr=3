                 -50*Ra+Pw*0.5+(Pw+Ps)*5
               mid3p4=68.0:-50*Ra+Pw*0.5+(Pw+Ps)*5
               mid3=dbCreatePath(cv "M3"
        list(mid3p1 mid3p2 mid3p3 mid3p4)
        Pw)
