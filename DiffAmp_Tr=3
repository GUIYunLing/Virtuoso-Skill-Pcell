; ============================================================================
;; DiffAmpPcell — 3-turn (Tr=3) only variant
;;
;; Purpose:
;;   Parametric layout cell (PCell) for a differential amplifier, restricted to
;;   the 3-turn configuration. Generated by extracting only the Tr=3 branch from
;;   the original multi-turn source; the Tr=5 / Tr=7 branches, debug printf
;;   statements, time-lock / authorization guard, SnapToMinSpacing and PcellCdf
;;   helpers have all been removed. Local geometry variables are renamed to the
;;   short audit/reconstruction identifiers from the restoration map.
;;
;; Structure:
;;   DiffAmpPcell(lib cell)  — entry point; invokes PcDefine to build the layout.
;;   CallBack()              — CDF parameter constraint logic for Tr=3
;;                             (Pw, Ps, Ra bounds, scaling and rounding).
;;   PcDefine(lib cell)      — pcDefinePCell body; generates the 3-turn geometry
;;                             (M3/M4 paths, 45-degree tails, VIA4/VIA5, pins).
;;
;; Key variables (short names):
;;   out0*  = OutsideMainPath1 (and its points/top/bottom/mirror)
;;   in6*   = InsideMainPath1  (and its points/top/bottom/mirror)
;;   mid3*  = MainPath2        (M3 path and its mirror/basic)
;;   mid4*  = MainPath1        (M4 path placeholders)
;;   tail1/tail2, grad1/grad2, l1/l2, ov = auxiliary path/list/overlap objects
;; ============================================================================

procedure(DiffAmpPcell(lib cell)
  let(()
  PcDefine(lib cell)
      )
); proc


procedure(CallBack()
  let((width space turns ratio)

   
    width = cdfgData~>Pw~>value
    space = cdfgData~>Ps~>value
    turns = cdfgData~>Tr~>value
    ratio = cdfgData~>Ra~>value
    case(turns
   ((3)

if(100*ratio<=(width+space)*5+5.0
   then cdfgData~>Ra~>value=int(((cdfgData~>Pw~>value)+(cdfgData~>Ps~>value))*5.0+5.0)*0.01
   warn("Aespect Ratio out of range"))


    _minPw = 2.6
    _maxPw = 14
    _minPs = 1.5
    _maxPs = 15
 
Pw_in = cdfgData~>Pw~>value
Ps_in = cdfgData~>Ps~>value
Pw = max(_minPw, min(_maxPw, Pw_in))
Ps = max(_minPs, min(_maxPs, Ps_in))

Pw = round( max(_minPw, min(_maxPw, Pw_in)) * 100.0 ) / 100.0
Ps = round( max(_minPs, min(_maxPs, Ps_in)) * 100.0 ) / 100.0


when( 14.0*Pw + 13.0*Ps >= 75.0
    scale = 75.0 / (14.0*Pw + 13.0*Ps)
    Pw = Pw * scale
    Ps = Ps * scale
    Pw = round( max(_minPw, min(_maxPw, Pw)) * 100.0 ) / 100.0
    Ps = round( max(_minPs, min(_maxPs, Ps)) * 100.0 ) / 100.0
)

when( Pw + Ps >= 5.4
    scale = 5.4 / (Pw + Ps)
    Pw = Pw * scale
    Ps = Ps * scale
    Pw = round( max(_minPw, min(_maxPw, Pw)) * 100.0 ) / 100.0
    Ps = round( max(_minPs, min(_maxPs, Ps)) * 100.0 ) / 100.0
)

if( 14.0*Pw + 13.0*Ps >= 75.0 + 1e-6 then
    scale = 75.0 / (14.0*Pw + 13.0*Ps)
    Pw = Pw * scale
    Ps = Ps * scale
    Pw = round( max(_minPw, min(_maxPw, Pw)) * 100.0 ) / 100.0
    Ps = round( max(_minPs, min(_maxPs, Ps)) * 100.0 ) / 100.0
)
if( Pw + Ps >= 5.4 + 1e-6 then
    scale = 5.4 / (Pw + Ps)
    Pw = Pw * scale
    Ps = Ps * scale
    Pw = round( max(_minPw, min(_maxPw, Pw)) * 100.0 ) / 100.0
    Ps = round( max(_minPs, min(_maxPs, Ps)) * 100.0 ) / 100.0
)

	


cdfgData~>Pw~>value = Pw
cdfgData~>Ps~>value = Ps



       )
  );case
    width=cdfgData~>Pw~>value
    width=int(width*100.0)/100.0
    space=cdfgData~>Ps~>value
    space=int(space*100.0)/100.0
    turns=cdfgData~>Tr~>value
    ratio=cdfgData~>Ra~>value
    ratio=int(ratio*100.0)/100.0
    );let
);proc
procedure(PcDefine(lib cell)
